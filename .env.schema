# API provider credentials for Pi (models.json) and OpenCode (opencode.jsonc).
# Safe to commit: secret keys are resolved from the pass store via the
# pass plugin (@varlock/pass-plugin) — only entry paths are stored here, never values.
# Expected pass layout: <ENV_VAR_NAME> (e.g. NVIDIA_API_KEY)
# @plugin(@varlock/pass-plugin@1.0.1)
# @initPass()
# @defaultSensitive=false
# @defaultRequired=true
# ---

# @sensitive=true
# @required=false
# @type=string(optional=true)
TRITONAI_API_KEY=pass("TRITONAI_API_KEY")
